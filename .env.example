# Copy to .env for local MAMP development. Never commit real secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smarthotel
DB_USER=root
DB_PASSWORD=root
DB_CONNECTION_LIMIT=10
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
GUEST_PII_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
LICENSE_FILE_PATH=
LICENSE_PUBLIC_KEY=
LOG_LEVEL=info

# Production example: set these in the hosting control panel, not in a file.
# NODE_ENV=production
# API_HOST=127.0.0.1
# API_PORT=3000
# WEB_ORIGIN=https://your-hotel-domain.example
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=your_cpanel_database
# DB_USER=your_cpanel_user
# DB_PASSWORD=replace-with-a-secret
# DB_CONNECTION_LIMIT=10
# JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
# GUEST_PII_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
# LICENSE_FILE_PATH=/secure/path/to/licence.json
# LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...vendor Ed25519 public key...\n-----END PUBLIC KEY-----"
# LOG_LEVEL=info
